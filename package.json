{
  "name": "@guidoshar/chat-motion-react",
  "version": "0.4.0",
  "description": "Themeable React thinking animations and streaming text cursors. Canvas + CSS, no UI framework required.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidoshar/chat-motion-react.git"
  },
  "homepage": "https://github.com/guidoshar/chat-motion-react#readme",
  "bugs": {
    "url": "https://github.com/guidoshar/chat-motion-react/issues"
  },
  "keywords": [
    "react",
    "thinking",
    "streaming",
    "sse",
    "cursor",
    "animation",
    "design-tokens"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "build:demo": "npm run build && tsc -p tsconfig.demo.json && vite build",
    "check:package": "node scripts/check-package.mjs",
    "capture:docs": "node scripts/capture-docs.mjs",
    "dev": "vite --host 127.0.0.1",
    "prepare": "npm run build"
  }
}
