{
  "name": "@guidoshar/chat-motion-react",
  "version": "0.3.0",
  "description": "Themeable React thinking animations and streaming text cursors. Canvas + CSS, no UI framework required.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidoshar/chat-motion-react.git"
  },
  "homepage": "https://github.com/guidoshar/chat-motion-react#readme",
  "bugs": {
    "url": "https://github.com/guidoshar/chat-motion-react/issues"
  },
  "keywords": [
    "react",
    "thinking",
    "streaming",
    "sse",
    "cursor",
    "animation",
    "design-tokens"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/chat-experience.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "build:demo": "npm run build && tsc -p tsconfig.demo.json && vite build",
    "check:package": "node scripts/check-package.mjs",
    "check:experience": "node scripts/check-experience.mjs",
    "capture:docs": "node scripts/capture-docs.mjs",
    "dev": "vite --host 127.0.0.1",
    "prepare": "npm run build"
  }
}
